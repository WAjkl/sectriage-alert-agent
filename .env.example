# 聚合窗口（分钟）
WINDOW_MIN=10
# 自动关闭的置信度门槛（低于它就转人工）
AUTO_CONF=0.8
# SOP 检索的最低分
SCORE_THRESHOLD=0.15

# 留空则走规则降级（不调模型也能跑通全链路）
LLM_BASE=
LLM_KEY=
LLM_MODEL=deepseek-chat
# 单次模型调用超时（秒）。熔断生效前，每个事件都要等满这个时间
LLM_TIMEOUT=25

# 熔断：连续失败几次开门 / 开门后冷却多少秒
BREAKER_THRESHOLD=3
BREAKER_COOLDOWN=30

# 边缘设备上报的共享令牌（留空=不校验，仅本机演示；对局域网开放时必须设置）
INGEST_TOKEN=
# 多久没上报算掉线（秒）。必须 ≥ 3× 设备心跳间隔，否则设备永远"假离线"
DEVICE_OFFLINE_SEC=180
